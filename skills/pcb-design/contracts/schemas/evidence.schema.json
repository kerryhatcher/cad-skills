{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kerryhatcher/cad-skills/contracts/evidence.schema.json",
  "title": "Check evidence",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_id": {
      "const": "cad-skills/evidence"
    },
    "schema_version": {
      "const": "1.0"
    },
    "check_id": {
      "type": "string",
      "pattern": "\\S",
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f]"
      }
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "pending",
        "unconfirmed"
      ]
    },
    "method": {
      "enum": [
        "tool",
        "manual"
      ]
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "\\S",
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f]"
          }
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$",
          "allOf": [
            {
              "not": {
                "pattern": "[\\u0000-\\u001f\\u007f]"
              }
            },
            {
              "not": {
                "enum": [
                  "latest",
                  "auto"
                ]
              }
            }
          ]
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "\\S"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          }
        },
        "required": [
          "path",
          "sha256"
        ]
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "reviewer": {
      "type": "string",
      "pattern": "\\S",
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f]"
      }
    },
    "observed_on": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "minLength": 10,
      "maxLength": 10,
      "format": "date"
    },
    "notes": {
      "type": "string",
      "pattern": "\\S"
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "check_id",
    "status",
    "method"
  ]
}

(version 1)
(rule "supplier_edge_keepout" (constraint edge_clearance (min 0.381mm)))
(rule "supplier_min_annular_ring" (constraint annular_width (min 0.1016mm)))
(rule "supplier_min_drill" (constraint hole_size (min 0.2032mm)))
(rule "supplier_min_space" (constraint clearance (min 0.127mm)))
(rule "supplier_min_trace" (constraint track_width (min 0.127mm)))
(rule "supplier_plated_drill_to_internal_copper" (constraint hole_clearance (min 0.254mm)))

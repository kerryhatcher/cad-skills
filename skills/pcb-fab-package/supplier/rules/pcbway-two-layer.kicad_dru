(version 1)
(rule "supplier_edge_keepout" (constraint edge_clearance (min 0.25mm)))
(rule "supplier_min_annular_ring" (constraint annular_width (min 0.254mm)))
(rule "supplier_min_drill" (constraint hole_size (min 0.2mm)))
(rule "supplier_min_space" (constraint clearance (min 0.1524mm)))
(rule "supplier_min_trace" (constraint track_width (min 0.127mm)))

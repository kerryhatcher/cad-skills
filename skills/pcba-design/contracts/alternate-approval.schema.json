{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kerryhatcher/cad-skills/skills/pcba-design/contracts/alternate-approval.schema.json",
  "title": "Alternate approval (cad-skills/alternate-approval 1.0), skill-owned, outside the shared registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "approvals"
  ],
  "properties": {
    "schema_id": {
      "const": "cad-skills/alternate-approval"
    },
    "schema_version": {
      "const": "1.0"
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference",
          "variant",
          "primary_part_path",
          "primary_sha256",
          "alternate_name",
          "alternate_part_path",
          "alternate_sha256",
          "application_evidence",
          "approved_by",
          "approved_on"
        ],
        "properties": {
          "reference": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,31}$"
          },
          "variant": {
            "type": "string",
            "pattern": "\\S"
          },
          "primary_part_path": {
            "type": "string",
            "pattern": "^components/"
          },
          "primary_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "alternate_name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$"
          },
          "alternate_part_path": {
            "type": "string",
            "pattern": "^components/"
          },
          "alternate_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "application_evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "retrieved",
              "statement"
            ],
            "properties": {
              "source": {
                "type": "string",
                "pattern": "\\S"
              },
              "retrieved": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "statement": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          },
          "approved_by": {
            "type": "string",
            "pattern": "\\S"
          },
          "approved_on": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kerryhatcher/cad-skills/contracts/waivers.schema.json",
  "title": "Waivers",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_id": {
      "const": "cad-skills/waivers"
    },
    "schema_version": {
      "const": "1.0"
    },
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "\\S",
            "not": {
              "pattern": "[\\u0000-\\u001f\\u007f]"
            }
          },
          "kind": {
            "enum": [
              "erc",
              "drc"
            ]
          },
          "rule": {
            "type": "string",
            "pattern": "\\S",
            "not": {
              "pattern": "[\\u0000-\\u001f\\u007f]"
            }
          },
          "objects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "\\S",
              "not": {
                "pattern": "[\\u0000-\\u001f\\u007f]"
              }
            }
          },
          "reason": {
            "type": "string",
            "pattern": "\\S"
          },
          "reviewer": {
            "type": "string",
            "pattern": "\\S",
            "not": {
              "pattern": "[\\u0000-\\u001f\\u007f]"
            }
          },
          "revision": {
            "type": "string",
            "pattern": "\\S",
            "not": {
              "pattern": "[\\u0000-\\u001f\\u007f]"
            }
          },
          "board_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "schematic_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          }
        },
        "required": [
          "id",
          "kind",
          "rule",
          "objects",
          "reason",
          "reviewer",
          "revision",
          "board_sha256",
          "schematic_sha256"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "erc"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "schematic_sha256": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "waivers"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kerryhatcher/cad-skills/contracts/part.schema.json",
  "title": "Part record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_id": {
      "const": "cad-skills/part"
    },
    "schema_version": {
      "const": "1.0"
    },
    "manufacturer": {
      "type": "string",
      "pattern": "\\S",
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f]"
      }
    },
    "mpn": {
      "type": "string",
      "pattern": "\\S",
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f]"
      }
    },
    "package": {
      "type": "string",
      "pattern": "\\S",
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f]"
      }
    },
    "symbol": {
      "type": "string",
      "pattern": "\\S",
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f]"
      }
    },
    "footprint": {
      "type": "string",
      "pattern": "\\S",
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f]"
      }
    },
    "datasheet_url": {
      "type": "string",
      "pattern": "^https?://[^\\s]",
      "not": {
        "pattern": "\\s"
      }
    },
    "datasheet_revision": {
      "type": "string",
      "pattern": "\\S",
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f]"
      }
    },
    "supplier_part_numbers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "supplier": {
            "type": "string",
            "pattern": "\\S",
            "not": {
              "pattern": "[\\u0000-\\u001f\\u007f]"
            }
          },
          "number": {
            "type": "string",
            "pattern": "\\S",
            "not": {
              "pattern": "[\\u0000-\\u001f\\u007f]"
            }
          }
        },
        "required": [
          "supplier",
          "number"
        ]
      }
    },
    "pin_map": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "\\S",
        "not": {
          "pattern": "[\\u0000-\\u001f\\u007f]"
        }
      },
      "propertyNames": {
        "pattern": "\\S",
        "not": {
          "pattern": "[\\u0000-\\u001f\\u007f]"
        }
      }
    },
    "polarity": {
      "type": "string",
      "pattern": "\\S",
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f]"
      }
    },
    "ratings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "pattern": "\\S",
            "not": {
              "pattern": "[\\u0000-\\u001f\\u007f]"
            }
          }
        },
        "required": [
          "value",
          "unit"
        ]
      },
      "propertyNames": {
        "pattern": "\\S",
        "not": {
          "pattern": "[\\u0000-\\u001f\\u007f]"
        }
      }
    },
    "temperature_range_c": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      },
      "required": [
        "min",
        "max"
      ]
    },
    "lifecycle": {
      "enum": [
        "active",
        "nrnd",
        "obsolete",
        "unknown"
      ]
    },
    "stock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "known",
            "unknown"
          ]
        },
        "quantity": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "type": "string",
          "pattern": "\\S"
        },
        "retrieved": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "format": "date",
          "minLength": 10,
          "maxLength": 10
        }
      },
      "required": [
        "status"
      ],
      "if": {
        "properties": {
          "status": {
            "const": "known"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "quantity",
          "source",
          "retrieved"
        ]
      },
      "else": {
        "maxProperties": 1
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "manufacturer",
    "mpn",
    "package",
    "symbol",
    "footprint",
    "datasheet_url",
    "datasheet_revision",
    "supplier_part_numbers",
    "pin_map",
    "polarity",
    "ratings",
    "temperature_range_c",
    "lifecycle",
    "stock"
  ]
}

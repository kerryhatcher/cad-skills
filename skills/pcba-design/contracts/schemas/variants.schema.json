{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kerryhatcher/cad-skills/contracts/variants.schema.json",
  "title": "Variant record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_id": {
      "const": "cad-skills/variants"
    },
    "schema_version": {
      "const": "1.0"
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "\\S",
            "not": {
              "pattern": "[\\u0000-\\u001f\\u007f]"
            }
          },
          "references": {
            "type": "object",
            "propertyNames": {
              "pattern": "\\S",
              "not": {
                "pattern": "[\\u0000-\\u001f\\u007f]"
              }
            },
            "additionalProperties": {
              "enum": [
                "populate",
                "dnp",
                "exclude_from_assembly"
              ]
            }
          },
          "hand_installed": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "reference": {
                  "type": "string",
                  "pattern": "\\S",
                  "not": {
                    "pattern": "[\\u0000-\\u001f\\u007f]"
                  }
                },
                "reason": {
                  "type": "string",
                  "pattern": "\\S"
                }
              },
              "required": [
                "reference",
                "reason"
              ]
            }
          }
        },
        "required": [
          "id",
          "references"
        ]
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "schema_id",
    "schema_version",
    "variants"
  ]
}
